# This file serves as an example for the required environment variables.
# Copy this file to a new file named .env and fill in your actual values.

# ===================================================================
# Backend Server Variables (used in server.js)
# ===================================================================

# Your Google Gemini API Key
# This is used by the Express server to make requests to the Gemini API.
GEMINI_API_KEY=your_google_gemini_api_key_here


# ===================================================================
# Frontend Client Variables (used by Vite)
# ===================================================================
# These variables are prefixed with VITE_ to be exposed to the client-side code.

# EmailJS Configuration (for payment reminders)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AdSense (optional)
VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# ===================================================================
# Next.js / App Router Variables (prefixed NEXT_PUBLIC_ so they are
# inlined into client components at build time)
# ===================================================================

# Google Analytics 4 Measurement ID (loads gtag.js in layout.tsx).
# Leave blank to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# -------------------------------------------------------------------
# Affiliate offer slots — PLACEHOLDER SYSTEM.
# Leave ALL blank until the owner supplies approved publisher URLs/IDs
# from a verified network (Affiliate.co.za / OfferForge). The site never
# renders fake links; components show a neutral note when these are empty.
#
# Naming: NEXT_PUBLIC_AFFILIATE_<VERTICAL>_0<SLOT>_URL  (and optional _ID)
# Verticals: BANK, MOBILE, EDUCATION, INSURANCE, FINANCE
# -------------------------------------------------------------------
NEXT_PUBLIC_AFFILIATE_BANK_01_URL=
NEXT_PUBLIC_AFFILIATE_BANK_01_ID=
NEXT_PUBLIC_AFFILIATE_BANK_02_URL=
NEXT_PUBLIC_AFFILIATE_BANK_02_ID=

NEXT_PUBLIC_AFFILIATE_MOBILE_01_URL=
NEXT_PUBLIC_AFFILIATE_MOBILE_01_ID=

NEXT_PUBLIC_AFFILIATE_EDUCATION_01_URL=
NEXT_PUBLIC_AFFILIATE_EDUCATION_01_ID=

NEXT_PUBLIC_AFFILIATE_INSURANCE_01_URL=
NEXT_PUBLIC_AFFILIATE_INSURANCE_01_ID=

NEXT_PUBLIC_AFFILIATE_FINANCE_01_URL=
NEXT_PUBLIC_AFFILIATE_FINANCE_01_ID=

# Re-enable the third-party (Adsterra/effectivecpm) network ONLY after
# AdSense approval. Disabled by default.
NEXT_PUBLIC_ENABLE_EFFECTIVECPM=false
