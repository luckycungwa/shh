# This file serves as an example for the required environment variables.
# Copy this file to a new file named .env and fill in your actual values.

# ===================================================================
# Backend Server Variables (used in server.js)
# ===================================================================

# Your Google Gemini API Key
# This is used by the Express server to make requests to the Gemini API.
GEMINI_API_KEY=your_google_gemini_api_key_here


# ===================================================================
# Frontend Client Variables (used by Vite)
# ===================================================================
# These variables are prefixed with VITE_ to be exposed to the client-side code.

# EmailJS Configuration (for payment reminders)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AdSense (optional)
VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
